# Copy to .env (or export as real environment variables) and fill in real values.
# Never commit a populated .env file.

APP_PROFILE=prod

DB_URL=jdbc:mysql://localhost:3306/eforms_dashboard?useSSL=false&serverTimezone=Asia/Kolkata
DB_USER=eforms_app
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=20

SERVER_PORT=8080
COOKIE_SECURE=true
SESSION_TIMEOUT=30m

MAX_FAILED_ATTEMPTS=5
LOCK_DURATION_MINUTES=15

FILE_STORAGE_ROOT=./storage/attachments
ATTACHMENT_MAX_MB=10

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional: pin the one-time bootstrap password for named initial accounts
# instead of letting the app auto-generate + log a random one.
# SEED_SANJAY_SINGH_PASSWORD=
# SEED_PRASHANT_CHATURVEDI_PASSWORD=
# SEED_POOJA_GEHLOD_PASSWORD=
# SEED_MAYURIKA_SRIVASTAVA_PASSWORD=
